<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css" />
  <style>
    .admin-wrap { max-width: 1100px; margin: 0 auto; padding: 32px 24px; }
    .admin-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
    .admin-header h1 { font-size: 1.8rem; color: #e2e8f0; }
    .admin-header h1 span { color: #a78bfa; }
    .tabs { display: flex; gap: 8px; margin-bottom: 28px; flex-wrap: wrap; }
    .tab-btn {
      padding: 8px 22px;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px;
      background: rgba(255,255,255,0.06);
      color: #94a3b8;
      cursor: pointer;
      font-size: 0.9rem;
      transition: all 0.2s;
    }
    .tab-btn.active, .tab-btn:hover { background: rgba(167,139,250,0.2); color: #c4b5fd; border-color: #7c3aed; }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }
    .admin-table { width: 100%; border-collapse: collapse; }
    .admin-table th {
      text-align: left; padding: 12px 16px;
      font-size: 0.8rem; text-transform: uppercase;
      color: #64748b; border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .admin-table td {
      padding: 12px 16px; color: #cbd5e1;
      font-size: 0.88rem; border-bottom: 1px solid rgba(255,255,255,0.05);
      vertical-align: middle;
    }
    .admin-table tr:hover td { background: rgba(255,255,255,0.03); }
    .del-btn {
      background: rgba(239,68,68,0.15); border: 1px solid #ef4444;
      color: #fca5a5; border-radius: 6px;
      padding: 4px 12px; font-size: 0.78rem; cursor: pointer; transition: all 0.2s;
    }
    .del-btn:hover { background: rgba(239,68,68,0.4); }
    .edit-btn {
      background: rgba(99,102,241,0.15); border: 1px solid #6366f1;
      color: #a5b4fc; border-radius: 6px;
      padding: 4px 12px; font-size: 0.78rem; cursor: pointer; transition: all 0.2s;
    }
    .edit-btn:hover { background: rgba(99,102,241,0.35); }
    .btn-group { display: flex; gap: 6px; }
    .stat-bar { display: flex; gap: 16px; margin-bottom: 28px; flex-wrap: wrap; }
    .stat-card {
      background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px; padding: 18px 24px; min-width: 120px; text-align: center;
    }
    .stat-card .num { font-size: 2rem; font-weight: 700; color: #a78bfa; }
    .stat-card .lbl { font-size: 0.8rem; color: #64748b; margin-top: 4px; }
    .sug-row-pending  { border-left: 3px solid rgba(245,158,11,0.6); }
    .sug-row-approved { border-left: 3px solid rgba(16,185,129,0.6); }
    .sug-row-rejected { border-left: 3px solid rgba(239,68,68,0.5); }
    .sug-pill {
      display: inline-block; padding: 2px 10px; border-radius: 20px;
      font-size: 0.72rem; font-weight: 600;
    }
    .sug-pending  { background: rgba(245,158,11,0.2); color: #fcd34d; }
    .sug-approved { background: rgba(16,185,129,0.2); color: #6ee7b7; }
    .sug-rejected { background: rgba(239,68,68,0.2);  color: #fca5a5; }
    .approve-btn {
      background: rgba(16,185,129,0.15); border: 1px solid #10b981;
      color: #6ee7b7; border-radius: 6px; padding: 4px 12px;
      font-size: 0.78rem; cursor: pointer; transition: all 0.2s;
    }
    .approve-btn:hover { background: rgba(16,185,129,0.4); }
    .reject-form { display: flex; gap: 6px; align-items: center; }
    .reject-note-input {
      background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15);
      border-radius: 6px; padding: 4px 8px; color: #e2e8f0;
      font-size: 0.78rem; width: 130px;
    }
    .badge-g { font-size: 0.72rem; padding: 2px 8px; border-radius: 12px; }
    .badge-male   { background: rgba(59,130,246,0.2);  color: #93c5fd; }
    .badge-female { background: rgba(236,72,153,0.2);  color: #f9a8d4; }
    .badge-other  { background: rgba(100,116,139,0.2); color: #94a3b8; }
    .badge-all    { background: rgba(99,102,241,0.2);  color: #a5b4fc; }
    /* Edit Modal */
    .modal-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.7); z-index: 999;
      align-items: center; justify-content: center;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      background: #1a1a2e; border: 1px solid rgba(167,139,250,0.3);
      border-radius: 16px; padding: 28px 32px; max-width: 500px; width: 94%;
      max-height: 90vh; overflow-y: auto;
    }
    .modal-box h3 { color: #c4b5fd; margin-bottom: 20px; font-size: 1.1rem; }
    .modal-box .form-input {
      width: 100%; padding: 9px 14px; border-radius: 8px;
      background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
      color: #e2e8f0; font-size: 0.9rem; margin-top: 6px; box-sizing: border-box;
    }
    .modal-box textarea.form-input { min-height: 80px; resize: vertical; }
    .modal-box label { color: #94a3b8; font-size: 0.82rem; display: block; margin-top: 14px; }
    .modal-actions { display: flex; gap: 10px; margin-top: 20px; }
    .save-btn {
      background: linear-gradient(135deg,#7c3aed,#6366f1); color:#fff;
      border: none; border-radius: 8px; padding: 9px 22px;
      font-weight: 600; cursor: pointer;
    }
    .cancel-btn {
      background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15);
      color: #94a3b8; border-radius: 8px; padding: 9px 22px; cursor: pointer;
    }
  </style>
</head>
<body style="background: #0f0f1a; min-height: 100vh;">

  <header class="site-header">
    <div class="container">
      <div class="logo"><a href="/">🎯 Hobby Hub</a></div>
      <nav class="main-nav" style="display:flex;align-items:center;gap:16px;">
        <ul class="nav-list">
          <li><a href="/home"  class="nav-link">🏠 Home</a></li>
          <li><a href="/admin" class="nav-link active">⚙️ Admin</a></li>
        </ul>
        <div class="profile-wrapper">
          <button class="profile-avatar-btn" onclick="toggleProfileMenu(event)" aria-label="Profile menu">A</button>
          <div class="profile-dropdown-menu" id="profileMenu">
            <div class="profile-info-header">
              <div class="profile-avatar-sm">A</div>
              <div>
                <strong style="display:block;color:#e2e8f0;font-size:0.9rem;">Admin</strong>
                <small style="color:#64748b;font-size:0.72rem;">Administrator</small>
              </div>
            </div>
            <div class="profile-menu-divider"></div>
            <a href="/logout" class="profile-menu-item">🚪 Logout</a>
          </div>
        </div>
      </nav>
    </div>
  </header>

  <div class="admin-wrap">
    <div class="admin-header">
      <h1>⚙️ Admin <span>Panel</span></h1>
      <span style="color:#64748b;font-size:0.88rem;">Logged in as Admin</span>
    </div>

    <div class="stat-bar">
      <div class="stat-card"><div class="num"><%= users.length %></div><div class="lbl">Users</div></div>
      <div class="stat-card"><div class="num"><%= hobbies.length %></div><div class="lbl">Hobbies</div></div>
      <div class="stat-card"><div class="num"><%= posts.length %></div><div class="lbl">Posts</div></div>
      <div class="stat-card"><div class="num"><%= events.length %></div><div class="lbl">Events</div></div>
      <div class="stat-card"><div class="num" style="color:<%= pendingCount>0?'#fcd34d':'#a78bfa' %>"><%= pendingCount %></div><div class="lbl">Pending Ideas</div></div>
    </div>

    <div class="tabs">
      <button class="tab-btn active" onclick="showTab('users',this)">👥 Users (<%= users.length %>)</button>
      <button class="tab-btn" onclick="showTab('hobbies',this)">🎯 Hobbies (<%= hobbies.length %>)</button>
      <button class="tab-btn" onclick="showTab('posts',this)">📝 Posts (<%= posts.length %>)</button>
      <button class="tab-btn" onclick="showTab('events',this)">📅 Events (<%= events.length %>)</button>
      <button class="tab-btn" onclick="showTab('suggestions',this)" id="sugTab"
        style="<%= pendingCount>0 ? 'border-color:#d97706;color:#fcd34d;background:rgba(245,158,11,0.1);' : '' %>">
        💡 Event Ideas (<%= suggestions.length %>)<%= pendingCount>0 ? ' 🔔' : '' %>
      </button>
    </div>

    <!-- USERS TAB -->
    <div id="tab-users" class="tab-panel active">
      <% if (users.length === 0) { %>
        <p style="color:#64748b;">No registered users yet.</p>
      <% } else { %>
        <table class="admin-table">
          <thead><tr>
            <th>Username</th><th>Email</th><th>Gender</th><th>Joined</th><th>Action</th>
          </tr></thead>
          <tbody>
            <% users.forEach(function(u) { %>
              <tr>
                <td><strong><%= u.username %></strong></td>
                <td><%= u.email %></td>
                <td><span class="badge-g badge-<%= u.gender %>"><%= u.gender %></span></td>
                <td><%= u.created_at ? new Date(u.created_at).toLocaleDateString('en-IN') : '—' %></td>
                <td>
                  <form action="/admin/delete/user/<%= u.id %>" method="POST" style="margin:0;"
                        onsubmit="return confirm('Delete user <%= u.username %>?')">
                    <button type="submit" class="del-btn">🗑 Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- HOBBIES TAB -->
    <div id="tab-hobbies" class="tab-panel">
      <% if (hobbies.length === 0) { %>
        <p style="color:#64748b;">No hobbies yet.</p>
      <% } else { %>
        <table class="admin-table">
          <thead><tr>
            <th>Title</th><th>Category</th><th>Difficulty</th><th>Time</th><th>Added By</th><th>Action</th>
          </tr></thead>
          <tbody>
            <% hobbies.forEach(function(h) { %>
              <tr>
                <td><strong><%= h.title %></strong></td>
                <td><%= h.category %></td>
                <td><%= h.difficulty %></td>
                <td><%= h.time_required || '—' %></td>
                <td><%= h.added_by_username || '—' %></td>
                <td>
                  <div class="btn-group">
                    <button class="edit-btn" onclick='openEditHobby(<%= JSON.stringify(h) %>)'>✏️ Edit</button>
                    <form action="/admin/delete/hobby/<%= h.id %>" method="POST" style="margin:0;"
                          onsubmit="return confirm('Delete hobby <%= h.title %>?')">
                      <button type="submit" class="del-btn">🗑 Del</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- POSTS TAB -->
    <div id="tab-posts" class="tab-panel">
      <% if (posts.length === 0) { %>
        <p style="color:#64748b;">No posts yet.</p>
      <% } else { %>
        <table class="admin-table">
          <thead><tr>
            <th>Title</th><th>Body</th><th>Author</th><th>Date</th><th>Action</th>
          </tr></thead>
          <tbody>
            <% posts.forEach(function(p) { %>
              <tr>
                <td><strong><%= p.title %></strong></td>
                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= p.body %></td>
                <td><%= p.author_username %></td>
                <td><%= p.created_at ? new Date(p.created_at).toLocaleDateString('en-IN') : '—' %></td>
                <td>
                  <div class="btn-group">
                    <button class="edit-btn" onclick='openEditPost(<%= JSON.stringify(p) %>)'>✏️ Edit</button>
                    <form action="/admin/delete/post/<%= p.id %>" method="POST" style="margin:0;"
                          onsubmit="return confirm('Delete this post?')">
                      <button type="submit" class="del-btn">🗑 Del</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- EVENTS TAB -->
    <div id="tab-events" class="tab-panel">
      <% if (events.length === 0) { %>
        <p style="color:#64748b;">No events yet.</p>
      <% } else { %>
        <table class="admin-table">
          <thead><tr>
            <th>Name</th><th>Date</th><th>Hobby</th><th>Gender</th><th>Joined</th><th>Action</th>
          </tr></thead>
          <tbody>
            <% events.forEach(function(ev) { %>
              <tr>
                <td><strong><%= ev.name %></strong></td>
                <td><%= ev.date %></td>
                <td><%= ev.hobby %></td>
                <td>
                  <%
                    let gcls = 'badge-all', gtxt = 'All';
                    if (ev.gender_restriction === 'female') { gcls = 'badge-female'; gtxt = 'Women Only'; }
                    else if (ev.gender_restriction === 'male') { gcls = 'badge-male'; gtxt = 'Men Only'; }
                  %>
                  <span class="badge-g <%= gcls %>"><%= gtxt %></span>
                </td>
                <td><%= ev.joined_by ? ev.joined_by.length : 0 %></td>
                <td>
                  <div class="btn-group">
                    <button class="edit-btn" onclick='openEditEvent(<%= JSON.stringify(ev) %>)'>✏️ Edit</button>
                    <form action="/admin/delete/event/<%= ev.id %>" method="POST" style="margin:0;"
                          onsubmit="return confirm('Delete event <%= ev.name %>?')">
                      <button type="submit" class="del-btn">🗑 Del</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- SUGGESTIONS TAB -->
    <div id="tab-suggestions" class="tab-panel">
      <% if (suggestions.length === 0) { %>
        <p style="color:#64748b;">No event suggestions yet.</p>
      <% } else { %>
        <table class="admin-table">
          <thead><tr>
            <th>Event Name</th><th>Date</th><th>Hobby</th><th>Gender</th><th>Suggested By</th><th>Status</th><th>Action</th>
          </tr></thead>
          <tbody>
            <% suggestions.forEach(function(s) { %>
              <tr class="sug-row-<%= s.status %>">
                <td><strong><%= s.name %></strong></td>
                <td><%= s.date %></td>
                <td><%= s.hobby %></td>
                <td>
                  <%
                    let sgcls = 'badge-all', sgtxt = 'All';
                    if (s.gender_restriction === 'female') { sgcls = 'badge-female'; sgtxt = 'Women Only'; }
                    else if (s.gender_restriction === 'male') { sgcls = 'badge-male'; sgtxt = 'Men Only'; }
                  %>
                  <span class="badge-g <%= sgcls %>"><%= sgtxt %></span>
                </td>
                <td style="color:#94a3b8;"><%= s.suggested_by_username %></td>
                <td><span class="sug-pill sug-<%= s.status %>">
                  <%= s.status === 'pending' ? '⏳ Pending' : s.status === 'approved' ? '✅ Approved' : '❌ Rejected' %>
                </span>
                <% if (s.admin_note) { %>
                  <div style="font-size:0.72rem;color:#64748b;margin-top:4px;">Note: "<%= s.admin_note %>"</div>
                <% } %>
                </td>
                <td>
                  <div class="btn-group" style="flex-wrap:wrap;gap:4px;">
                    <% if (s.status === 'pending') { %>
                      <form action="/admin/suggestions/approve/<%= s.id %>" method="POST" style="margin:0;">
                        <button type="submit" class="approve-btn">✅ Approve</button>
                      </form>
                      <form action="/admin/suggestions/reject/<%= s.id %>" method="POST" style="margin:0;" class="reject-form">
                        <input type="text" name="admin_note" class="reject-note-input" placeholder="Reason (optional)" />
                        <button type="submit" class="del-btn">❌ Reject</button>
                      </form>
                    <% } %>
                    <form action="/admin/suggestions/delete/<%= s.id %>" method="POST" style="margin:0;"
                          onsubmit="return confirm('Remove this suggestion?')">
                      <button type="submit" class="del-btn">🗑 Del</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

  </div>

  <!-- EDIT HOBBY MODAL -->
  <div class="modal-overlay" id="editHobbyModal">
    <div class="modal-box">
      <h3>✏️ Edit Hobby</h3>
      <form id="editHobbyForm" method="POST">
        <label>Title</label>
        <input type="text" name="title" id="eh-title" class="form-input" required />
        <label>Description</label>
        <textarea name="description" id="eh-desc" class="form-input"></textarea>
        <label>Category</label>
        <input type="text" name="category" id="eh-cat" class="form-input" />
        <label>Difficulty</label>
        <select name="difficulty" id="eh-diff" class="form-input">
          <option value="Beginner">Beginner</option>
          <option value="Intermediate">Intermediate</option>
          <option value="Advanced">Advanced</option>
        </select>
        <label>Time Required</label>
        <input type="text" name="time_required" id="eh-time" class="form-input" placeholder="e.g. 1-2 hours" />
        <div class="modal-actions">
          <button type="submit" class="save-btn">💾 Save</button>
          <button type="button" class="cancel-btn" onclick="closeModal('editHobbyModal')">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <!-- EDIT POST MODAL -->
  <div class="modal-overlay" id="editPostModal">
    <div class="modal-box">
      <h3>✏️ Edit Post</h3>
      <form id="editPostForm" method="POST">
        <label>Title</label>
        <input type="text" name="title" id="ep-title" class="form-input" required />
        <label>Body</label>
        <textarea name="body" id="ep-body" class="form-input"></textarea>
        <div class="modal-actions">
          <button type="submit" class="save-btn">💾 Save</button>
          <button type="button" class="cancel-btn" onclick="closeModal('editPostModal')">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <!-- EDIT EVENT MODAL -->
  <div class="modal-overlay" id="editEventModal">
    <div class="modal-box">
      <h3>✏️ Edit Event</h3>
      <form id="editEventForm" method="POST">
        <label>Event Name</label>
        <input type="text" name="name" id="ee-name" class="form-input" required />
        <label>Date</label>
        <input type="date" name="date" id="ee-date" class="form-input" />
        <label>Related Hobby</label>
        <input type="text" name="hobby" id="ee-hobby" class="form-input" />
        <label>Who can join?</label>
        <select name="gender_restriction" id="ee-gender" class="form-input">
          <option value="all">Everyone (All Genders)</option>
          <option value="female">Women Only 👩</option>
          <option value="male">Men Only 👨</option>
        </select>
        <div class="modal-actions">
          <button type="submit" class="save-btn">💾 Save</button>
          <button type="button" class="cancel-btn" onclick="closeModal('editEventModal')">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function showTab(name, btn) {
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('tab-' + name).classList.add('active');
      btn.classList.add('active');
    }
    function closeModal(id) {
      document.getElementById(id).classList.remove('open');
    }
    function openEditHobby(h) {
      document.getElementById('eh-title').value = h.title || '';
      document.getElementById('eh-desc').value  = h.description || '';
      document.getElementById('eh-cat').value   = h.category || '';
      document.getElementById('eh-diff').value  = h.difficulty || 'Beginner';
      document.getElementById('eh-time').value  = h.time_required || '';
      document.getElementById('editHobbyForm').action = '/admin/edit/hobby/' + h.id;
      document.getElementById('editHobbyModal').classList.add('open');
    }
    function openEditPost(p) {
      document.getElementById('ep-title').value = p.title || '';
      document.getElementById('ep-body').value  = p.body || '';
      document.getElementById('editPostForm').action = '/admin/edit/post/' + p.id;
      document.getElementById('editPostModal').classList.add('open');
    }
    function openEditEvent(ev) {
      document.getElementById('ee-name').value   = ev.name || '';
      document.getElementById('ee-date').value   = ev.date ? ev.date.split('T')[0] : '';
      document.getElementById('ee-hobby').value  = ev.hobby || '';
      document.getElementById('ee-gender').value = ev.gender_restriction || 'all';
      document.getElementById('editEventForm').action = '/admin/edit/event/' + ev.id;
      document.getElementById('editEventModal').classList.add('open');
    }
    document.querySelectorAll('.modal-overlay').forEach(m => {
      m.addEventListener('click', function(e) {
        if (e.target === this) this.classList.remove('open');
      });
    });
    function toggleProfileMenu(e) {
      e.stopPropagation();
      document.getElementById('profileMenu').classList.toggle('open');
    }
    document.addEventListener('click', function() {
      const m = document.getElementById('profileMenu');
      if (m) m.classList.remove('open');
    });
  </script>
</body>
</html>
