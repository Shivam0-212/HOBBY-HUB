<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>

  <header class="site-header">
    <div class="container">
      <div class="logo"><a href="/">🎯 Hobby Hub</a></div>
      <nav class="main-nav">
        <ul class="nav-list">
          <li><a href="/"          class="nav-link">Home</a></li>
          <li><a href="/explore"   class="nav-link">Explore</a></li>
          <li><a href="/community" class="nav-link">Community</a></li>
          <li><a href="/login"     class="nav-link">Login</a></li>
          <li><a href="/register"  class="nav-link active">Register</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="auth-page">
    <div class="auth-card">
      <div class="auth-icon">🚀</div>
      <h1 class="auth-title">Create Account</h1>
      <p class="auth-subtitle">Join the Hobby Hub community today</p>

      <% if (error) { %>
        <div class="alert alert-error">❌ <%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success">✅ <%= success %> <a href="/login" style="color:inherit;font-weight:700;text-decoration:underline;">Login now →</a></div>
      <% } %>

      <form action="/register" method="POST" id="regForm" novalidate>
        <div class="form-group">
          <label class="form-label">Username <span class="required">*</span></label>
          <input type="text" name="username" id="regUser" class="form-input"
                 placeholder="Choose a username (min 3 chars)" autocomplete="username" />
          <span class="field-error" id="errUser"></span>
        </div>

        <div class="form-group">
          <label class="form-label">Email <span class="required">*</span></label>
          <input type="email" name="email" id="regEmail" class="form-input"
                 placeholder="Enter your email address" autocomplete="email" />
          <span class="field-error" id="errEmail"></span>
        </div>

        <div class="form-group">
          <label class="form-label">Gender <span class="required">*</span></label>
          <select name="gender" id="regGender" class="form-input form-select">
            <option value="">-- Select gender --</option>
            <option value="male">Male</option>
            <option value="female">Female</option>
            <option value="other">Other / Prefer not to say</option>
          </select>
          <span class="field-error" id="errGender"></span>
        </div>

        <div class="form-group">
          <label class="form-label">Password <span class="required">*</span></label>
          <input type="password" name="password" id="regPass" class="form-input"
                 placeholder="At least 6 characters" autocomplete="new-password" />
          <span class="field-error" id="errPass"></span>
        </div>

        <div class="form-group">
          <label class="form-label">Confirm Password <span class="required">*</span></label>
          <input type="password" name="confirmPassword" id="regConfirm" class="form-input"
                 placeholder="Re-enter your password" autocomplete="new-password" />
          <span class="field-error" id="errConfirm"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-large" style="width:100%;margin-top:4px;">
          Create Account →
        </button>
      </form>

      <div class="auth-link">
        Already have an account? <a href="/login">Login here</a>
      </div>
    </div>
  </main>

  <script>
    const passEl    = document.getElementById('regPass');
    const confirmEl = document.getElementById('regConfirm');
    confirmEl.addEventListener('input', function() {
      document.getElementById('errConfirm').textContent =
        this.value && this.value !== passEl.value ? 'Passwords do not match.' : '';
      this.style.borderColor = this.value && this.value !== passEl.value ? '#ef4444' : '';
    });

    document.getElementById('regForm').addEventListener('submit', function(e) {
      let ok = true;
      const u  = document.getElementById('regUser');
      const em = document.getElementById('regEmail');
      const g  = document.getElementById('regGender');
      const p  = document.getElementById('regPass');
      const c  = document.getElementById('regConfirm');
      ['errUser','errEmail','errGender','errPass','errConfirm'].forEach(id => document.getElementById(id).textContent = '');
      [u, em, g, p, c].forEach(el => el.style.borderColor = '');

      if (!u.value.trim() || u.value.trim().length < 3) {
        document.getElementById('errUser').textContent = 'Username must be at least 3 characters.';
        u.style.borderColor = '#ef4444'; ok = false;
      }
      const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!em.value.trim() || !emailRe.test(em.value)) {
        document.getElementById('errEmail').textContent = 'Enter a valid email address.';
        em.style.borderColor = '#ef4444'; ok = false;
      }
      if (!g.value) {
        document.getElementById('errGender').textContent = 'Please select your gender.';
        g.style.borderColor = '#ef4444'; ok = false;
      }
      if (!p.value || p.value.length < 6) {
        document.getElementById('errPass').textContent = 'Password must be at least 6 characters.';
        p.style.borderColor = '#ef4444'; ok = false;
      }
      if (p.value !== c.value) {
        document.getElementById('errConfirm').textContent = 'Passwords do not match.';
        c.style.borderColor = '#ef4444'; ok = false;
      }
      if (!ok) e.preventDefault();
    });
  </script>
</body>
</html>
