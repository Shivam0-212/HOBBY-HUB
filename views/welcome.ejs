<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css" />
  <style>
    /* Welcome page: full-viewport split layout */
    body { overflow: hidden; }

    .welcome-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      padding: 24px;
    }

    /* Animated floating orbs */
    .orb {
      position: fixed;
      border-radius: 50%;
      pointer-events: none;
      animation: orb-float 6s ease-in-out infinite alternate;
    }
    .orb-1 { width: 400px; height: 400px; top: -120px; left: -100px; background: radial-gradient(circle, rgba(139,92,246,0.22), transparent 70%); animation-duration: 7s; }
    .orb-2 { width: 320px; height: 320px; bottom: -80px; right: -60px;  background: radial-gradient(circle, rgba(6,182,212,0.18),  transparent 70%); animation-duration: 5s; }
    .orb-3 { width: 200px; height: 200px; top: 40%;    left: 60%;        background: radial-gradient(circle, rgba(244,114,182,0.14),transparent 70%); animation-duration: 8s; }
    @keyframes orb-float {
      from { transform: translate(0, 0) scale(1); }
      to   { transform: translate(30px, 20px) scale(1.08); }
    }

    /* Central card */
    .welcome-card {
      position: relative;
      z-index: 10;
      text-align: center;
      max-width: 480px;
      width: 100%;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 28px;
      padding: 56px 48px;
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      box-shadow: 0 32px 80px rgba(0,0,0,0.6), 0 0 40px rgba(139,92,246,0.25);
      animation: card-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes card-in {
      from { opacity: 0; transform: translateY(40px) scale(0.95); }
      to   { opacity: 1; transform: translateY(0)    scale(1); }
    }

    .welcome-logo {
      font-size: 3.2rem;
      margin-bottom: 8px;
      animation: float 3.5s ease-in-out infinite;
    }

    .welcome-brand {
      font-size: 2.2rem;
      font-weight: 900;
      margin-bottom: 10px;
      background: linear-gradient(135deg, #a78bfa, #38bdf8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .welcome-tagline {
      color: rgba(148, 163, 184, 0.85);
      font-size: 0.97rem;
      margin-bottom: 48px;
      line-height: 1.6;
    }

    .welcome-buttons {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .btn-welcome-login {
      display: block;
      padding: 15px 0;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      background: linear-gradient(135deg, #7c3aed, #8b5cf6);
      color: white;
      border: none;
      box-shadow: 0 6px 20px rgba(124,58,237,0.5);
      transition: all 0.25s;
      cursor: pointer;
      text-decoration: none;
      letter-spacing: 0.3px;
    }
    .btn-welcome-login:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 30px rgba(124,58,237,0.7);
    }

    .btn-welcome-register {
      display: block;
      padding: 15px 0;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 700;
      background: rgba(255,255,255,0.08);
      color: rgba(226,232,240,0.9);
      border: 1px solid rgba(255,255,255,0.22);
      transition: all 0.25s;
      cursor: pointer;
      text-decoration: none;
      backdrop-filter: blur(8px);
      letter-spacing: 0.3px;
    }
    .btn-welcome-register:hover {
      background: rgba(255,255,255,0.14);
      border-color: rgba(167,139,250,0.6);
      color: #a78bfa;
      transform: translateY(-3px);
    }

    .welcome-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      color: rgba(148,163,184,0.4);
      font-size: 0.8rem;
    }
    .welcome-divider::before,
    .welcome-divider::after {
      content: ''; flex: 1;
      height: 1px;
      background: rgba(255,255,255,0.1);
    }

    /* Small floating badges at bottom */
    .welcome-features {
      display: flex;
      justify-content: center;
      gap: 16px;
      margin-top: 36px;
      flex-wrap: wrap;
    }
    .feature-badge {
      font-size: 0.78rem;
      color: rgba(148,163,184,0.7);
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      padding: 5px 12px;
      border-radius: 20px;
    }

    @media (max-width: 480px) {
      .welcome-card { padding: 40px 28px; }
      .welcome-brand { font-size: 1.8rem; }
      body { overflow: auto; }
    }
  </style>
</head>
<body>

  <!-- Floating background orbs for 3D depth -->
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>

  <main class="welcome-page">
    <div class="welcome-card">

      <div class="welcome-logo">🎯</div>
      <h1 class="welcome-brand">Hobby Hub</h1>
      <p class="welcome-tagline">
        Discover new passions, share your experiences,<br />
        and connect with a community of enthusiasts.
      </p>

      <div class="welcome-buttons">
        <a href="/login" class="btn-welcome-login">🔑 Login to your account</a>

        <div class="welcome-divider">or</div>

        <a href="/register" class="btn-welcome-register">🚀 Create a new account</a>
      </div>

      <div class="welcome-features">
        <span class="feature-badge">🎨 10+ Hobbies</span>
        <span class="feature-badge">🌍 Community</span>
        <span class="feature-badge">📅 Events</span>
        <span class="feature-badge">✅ Free to Use</span>
      </div>

    </div>
  </main>

</body>
</html>
